library(dplyr)
library(Knitr)

#renaming and adding new collumn 'Einkommen', original labels from Socisurvey
new_data6 <- new_data5 %>% 
     dplyr::mutate(Einkommen = dplyr::case_when(
        SO16 == 12 ~ "bis 1.500 €",
        SO16 == 6  ~ "1.501 € bis 2.000 €",
         SO16 == 7  ~ "2001 bis 3.000 €",
         SO16 == 8  ~ "3001 bis 4000 €",
         SO16 == 11 ~ "über 4001 €",
         TRUE       ~ "-9"  # Fängt alle anderen Werte (wie z.B. -9) ab
     ))

#factoring for further analysis
new_data6$Einkommen <- factor(
     new_data6$Einkommen, 
     levels = c(
         "bis 1.500 €", 
         "1.501 € bis 2.000 €", 
         "2001 bis 3.000 €", 
         "3001 bis 4000 €", 
         "über 4001 €", 
         "-9"
     ))

#create descriptive Overview of the salary (Einkommen)

Haeufigkeitstabelle_Einkommen <- setNames(
  transform(
    as.data.frame(table(new_data6$Einkommen)),
    Prozent = round(Freq / sum(Freq) * 100, 2),
    Kumuliert_Anzahl = cumsum(Freq),
    Kumuliert_Prozent = round(cumsum(Freq / sum(Freq) * 100), 2)
  ),
  c("Gehaltsklasse", "Anzahl", "Prozent", "Kumuliert_Anzahl", "Kumuliert_Prozent")
)

print(Haeufigkeitstabelle_Einkommen)


#the same for the gender

new_data6 <- new_data6 %>% 
     dplyr::mutate(Geschlecht = dplyr::case_when(
         SD01 == 1 ~ "Männlich",
         SD01 == 2  ~ "Weiblich", 
         SD01 == 3  ~ "Divers",
         SD01 == 4  ~ "keine Angabe",
         
         TRUE       ~ "-9"  # Fängt alle anderen Werte (wie z.B. -9) ab
     ))

new_data6$Geschlecht <- factor(
      new_data6$Geschlecht, 
      levels = c(
          "Männlich", 
          "Weiblich", 
          "Divers", 
          "keine Angabe", 
           "-9"
      ))

Verteilung_Geschlecht <- new_data6 %>% 
     dplyr::count(Geschlecht) %>% 
     dplyr::mutate(
         Prozent = (n / sum(n)) * 100,
         Prozent_Gerundet = round(Prozent, 2) # Optional: Auf 2 Nachkommastellen runden
     )

Verteilung_Geschlecht %>% 
    dplyr::select(Geschlecht, n, Prozent_Gerundet) %>% 
     knitr::kable(
         col.names = c("Geschlecht", "Anzahl (n)", "Anteil (%)"), # Schöne Spaltennamen
         align = "lrr",                                         # l = linksbündig, r = rechtsbündig
         caption = "Tabelle 1: Geschlechterverteilung im Datensatz" # Dein Titel!
     )


Haeufigkeitstabelle_Alter <- setNames(
     transform(
     as.data.frame(table(new_data6$SD02_01)),
         Prozent = round(Freq / sum(Freq) * 100, 2),
         Kumuliert_Anzahl = cumsum(Freq),
         Kumuliert_Prozent = round(cumsum(Freq / sum(Freq) * 100), 2)
     ),
     c("Alter", "Anzahl", "Prozent", "Kumuliert_Anzahl", "Kumuliert_Prozent")
 )

print(Haeufigkeitstabelle_Alter)
Verteilung_Alter <- new_data6 %>%
    
    dplyr::mutate(SD02_01 = as.numeric(as.character(SD02_01))) %>%
     dplyr::mutate(Altersgruppe = cut(SD02_01, 
                                      breaks = seq(25, 55, by = 5), 
                                      right = FALSE))


Verteilung_Alter %>%  # 4. Häufigkeiten der Gruppen zählen
    dplyr::count(Altersgruppe) %>%
    
     # 5. Prozentanteile berechnen und runden
     dplyr::mutate(Prozent = round((n / sum(n)) * 100, 2)) %>%
     
     # 6. Als schöne Tabelle mit Titel ausgeben
     knitr::kable(
         col.names = c("Altersgruppe", "Anzahl (n)", "Anteil (%)"),
         align = "lrr",
         caption = "Häufigkeitsverteilung der Altersgruppen (ab 25 Jahre bis 55 Jahre)"
     )



