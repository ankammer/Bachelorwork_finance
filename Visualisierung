#Ausbildung

# 1. Daten bereinigen (-9 und NAs entfernen)
ausbildung_clean <- droplevels(as.factor(new_data6$Ausbildung[new_data6$Ausbildung != "-9" & !is.na(new_data6$Ausbildung)]))

# 2. Häufigkeiten und Prozente berechnen
anzahl <- table(ausbildung_clean)
prozent <- round(prop.table(anzahl) * 100, 1)

# 3. Ränder anpassen: unten=5, links=17, oben=4, rechts=6
par(mar = c(5, 17, 4, 6))

# 4. Horizontales Balkendiagramm ohne Standard-Labels zeichnen
bp <- barplot(
  anzahl,
  horiz = TRUE,
  names.arg = "", # Standard-Labels ausblenden
  main = "Verteilung nach Ausbildungsabschluss",
  xlab = "Anzahl der Befragten",
  col = "steelblue",
  border = "darkblue",
  xlim = c(0, max(anzahl) * 1.45)
)

# 5. Links-bündige Beschriftung der Y-Achse setzen (adj = 0 bedeutet linksbündig)
mtext(
  text = names(anzahl),
  side = 2,
  line = 16, # Abstand vom Balken nach links (entspricht fast dem linken Rand)
  at = bp,
  las = 1,
  adj = 0,
  cex = 0.85
)

# 6. Anzahl und Prozent rechts neben die Balken schreiben
text(
  x = anzahl,
  y = bp,
  labels = paste0(" ", anzahl, " (", prozent, "%)"),
  pos = 4,
  cex = 0.85,
  xpd = TRUE
)


Einkommen und Abschluss 

# 1. Saubere Kreuztabelle erstellen
kreuztabelle_Ausbildung <- table(
  Einkommen = new_data6$Einkommen, 
  Ausbildung = droplevels(as.factor(new_data6$Ausbildung)),
  exclude = "-9"
)

# 2. Spaltenprozente für die OPTIK (damit alle Balken exakt gleich lang = 100 % sind)
balken_laenge <- prop.table(kreuztabelle_Ausbildung, margin = 2) * 100
balken_laenge[is.nan(balken_laenge)] <- 0

# 3. Gesamtprozente für die ZAHLEN (bezogen auf alle 271 Datensätze = 100 %)
zahlen_gesamt <- prop.table(kreuztabelle_Ausbildung) * 100

# 4. Lange Beschriftungen mit Zeilenumbruch versehen
labels_links <- gsub(" / ", " /\n", colnames(balken_laenge))
labels_links <- gsub("\\(", "\n(", labels_links)

# --- EXPORT START: Grafik als breites PNG (1400x650 Pixel) öffnen ---
png("Einkommen_Ausbildung_GleichLang_Gesamt271.png", width = 1400, height = 650, res = 120)

# 5. Ränder anpassen
par(oma = c(0, 0, 0, 0), mar = c(5, 16, 4, 11))

# 6. Farbpalette
farben <- rainbow(nrow(balken_laenge), s = 0.6, v = 0.9)

# 7. Horizontales Balkendiagramm zeichnen (alle Balken gleich lang bis 100 %)
bp <- barplot(
  balken_laenge,
  horiz = TRUE,
  beside = FALSE,
  space = 0.4,
  names.arg = rep("", ncol(balken_laenge)),
  main = "Einkommensverteilung nach Abschluss (Balken normiert, Zahlen = Anteil an n = 271)",
  xlab = "Relative Verteilung innerhalb des Abschlusses (Beschriftung = % der Gesamtstichprobe)",
  col = farben,
  border = "white",
  xlim = c(0, 100)
)

# 8. Gesamtprozente (bezogen auf 271) an die Positionen der gestreckten Abschnitte schreiben
for (i in seq_len(ncol(balken_laenge))) {
  optik_werte <- balken_laenge[, i]
  echte_prozent <- zahlen_gesamt[, i]
  x_pos <- cumsum(optik_werte) - (optik_werte / 2)
  
  # Nur beschriften, wenn der Balkenabschnitt breit genug ist (>= 4 % Balkenbreite)
  labels_txt <- ifelse(optik_werte >= 4, paste0(round(echte_prozent, 1), "%"), "")
  text(x = x_pos, y = bp[i], labels = labels_txt, cex = 0.8, col = "black")
}

# 9. Ausbildungsabschlüsse links zeichnen
axis(
  side = 2,
  at = bp,
  labels = labels_links,
  tick = FALSE,
  las = 1,
  cex.axis = 0.85
)

# 10. Legende rechts außerhalb platzieren
legend(
  "topright",
  inset = c(-0.24, 0),
  legend = rownames(balken_laenge),
  fill = farben,
  title = "Einkommen",
  cex = 0.8,
  bty = "n",
  xpd = TRUE
)

