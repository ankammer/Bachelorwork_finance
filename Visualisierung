#Ausbildung

# 1. Daten bereinigen (-9 und NAs entfernen)
ausbildung_clean <- droplevels(as.factor(new_data6$Ausbildung[new_data6$Ausbildung != "-9" & !is.na(new_data6$Ausbildung)]))

# 2. Häufigkeiten und Prozente berechnen
anzahl <- table(ausbildung_clean)
prozent <- round(prop.table(anzahl) * 100, 1)

# 3. Ränder anpassen: unten=5, links=17, oben=4, rechts=6
par(mar = c(5, 17, 4, 6))

# 4. Horizontales Balkendiagramm ohne Standard-Labels zeichnen
bp <- barplot(
  anzahl,
  horiz = TRUE,
  names.arg = "", # Standard-Labels ausblenden
  main = "Verteilung nach Ausbildungsabschluss",
  xlab = "Anzahl der Befragten",
  col = "steelblue",
  border = "darkblue",
  xlim = c(0, max(anzahl) * 1.45)
)

# 5. Links-bündige Beschriftung der Y-Achse setzen (adj = 0 bedeutet linksbündig)
mtext(
  text = names(anzahl),
  side = 2,
  line = 16, # Abstand vom Balken nach links (entspricht fast dem linken Rand)
  at = bp,
  las = 1,
  adj = 0,
  cex = 0.85
)

# 6. Anzahl und Prozent rechts neben die Balken schreiben
text(
  x = anzahl,
  y = bp,
  labels = paste0(" ", anzahl, " (", prozent, "%)"),
  pos = 4,
  cex = 0.85,
  xpd = TRUE
)
